[Unit]
Description=CryptoRecorder Replay Store Build (previous UTC day)
Documentation=file:///home/zsom/services/CryptoRecorder/docs/REPLAY_STORE.md
After=network.target

[Service]
Type=oneshot
User=zsom
Group=zsom
WorkingDirectory=/home/zsom/services/CryptoRecorder
EnvironmentFile=-/etc/cryptorecorder/cryptorecorder.env
# daily_build requires an explicit YYYY-MM-DD date or the 'yesterday' shortcut,
# which resolves to the previous completed UTC day. It always builds the
# replay store (there is no --steps flag; daily_build is replay-only).
ExecStart=/home/zsom/services/CryptoRecorder/.venv/bin/python -m pipeline.daily_build --date yesterday
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cryptorecorder-replay-build

Restart=on-failure
RestartSec=300
TimeoutStartSec=3600

# Security hardening
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
