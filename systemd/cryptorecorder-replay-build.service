[Unit]
Description=CryptoRecorder Replay Store Build (previous UTC day)
Documentation=file:///home/zsom/services/CryptoRecorder/docs/REPLAY_STORE.md
After=network.target
# Hard restart-burst guard: cap at 3 attempts per 24 hours so a deterministic
# failure cannot loop forever even if Restart is ever re-enabled.
StartLimitIntervalSec=86400
StartLimitBurst=3

[Service]
Type=oneshot
User=zsom
Group=zsom
WorkingDirectory=/home/zsom/services/CryptoRecorder
EnvironmentFile=-/etc/cryptorecorder/cryptorecorder.env
# daily_build requires an explicit YYYY-MM-DD date or the 'yesterday' shortcut,
# which resolves to the previous completed UTC day. It always builds the
# replay store (there is no --steps flag; daily_build is replay-only).
ExecStart=/home/zsom/services/CryptoRecorder/.venv/bin/python -m pipeline.daily_build --date yesterday
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cryptorecorder-replay-build

Restart=no
RestartSec=300
# No start timeout: replay builds over the full top50 universe can legitimately
# run well past 1 hour (e.g. backfills, --force rebuilds, large multi-day
# gaps). A finite TimeoutStartSec would SIGTERM/SIGKILL an in-progress,
# otherwise-healthy build. StartLimitIntervalSec/StartLimitBurst above still
# cap restart attempts if Restart is ever re-enabled.
TimeoutStartSec=infinity

# Security hardening
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
