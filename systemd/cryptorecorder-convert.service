# NOT installed/enabled/started by scripts/deploy_linux_server.sh. Production
# automatically runs only cryptorecorder-recorder.service and
# cryptorecorder-replay-build.timer; this legacy unit is kept only as a
# manual/reference template, and any already-installed copy is
# stopped/disabled/removed automatically by cleanup_stale_units() on the
# next deploy. See docs/OPERATIONS.md "Deployment Script Reference".
[Unit]
Description=CryptoRecorder Legacy Converter (RAW to Nautilus full-L2 catalog)
Documentation=file:///home/zsom/services/CryptoRecorder/convert_day.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zsom
Group=zsom
WorkingDirectory=/home/zsom/services/CryptoRecorder
EnvironmentFile=-/etc/cryptorecorder/cryptorecorder.env
# No --date: convert_day.py defaults to the previous UTC day.
ExecStart=/home/zsom/services/CryptoRecorder/.venv/bin/python convert_day.py --staging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cryptorecorder-convert

# Resource limits
MemoryMax=4G
CPUQuota=100%

[Install]
WantedBy=multi-user.target
