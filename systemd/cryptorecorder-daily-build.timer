[Unit]
Description=CryptoRecorder Daily Build Timer
Documentation=file:///home/zsom/services/CryptoRecorder/docs/DAILY_BUILD_PIPELINE.md
PartOf=cryptorecorder.target

[Timer]
# Run at 01:00 UTC daily (allows previous day hourly rotation and zstd compression to complete)
OnCalendar=*-*-* 01:00:00 UTC

# Timezone for calendar calculation
Timezone=UTC

# Run immediately if system was down at scheduled time
Persistent=true

# Accuracy of timer (1 minute)
AccuracySec=1min

# Run unit on timer elapse
Unit=cryptorecorder-daily-build.service

[Install]
WantedBy=timers.target
