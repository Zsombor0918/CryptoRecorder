[Unit]
Description=Nautilus Data Converter Timer (daily conversion at 00:10 UTC)

[Timer]
# Run after the previous UTC day has fully closed.
OnCalendar=*-*-* 00:10:00 UTC
Unit=nautilus-convert.service

# If the system was off at 00:10 UTC, run as soon as possible after boot
Persistent=true

# Run with user accuracy (don't cluster with other timers)
AccuracySec=1min

[Install]
WantedBy=timers.target
