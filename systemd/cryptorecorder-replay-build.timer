[Unit]
Description=CryptoRecorder Replay Store Build Timer (daily, 01:00 UTC)

[Timer]
# Run after the legacy converter has had time to finish the previous UTC day.
OnCalendar=*-*-* 01:00:00 UTC
Timezone=UTC
Unit=cryptorecorder-replay-build.service

Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
