# CryptoRecorder runtime environment (TEMPLATE).
#
# Copy this file to /etc/cryptorecorder/cryptorecorder.env on the server and edit
# as needed. The systemd units load it via `EnvironmentFile=-/etc/.../cryptorecorder.env`.
#
# NOTES:
#   * This file holds NON-SECRET runtime tuning only. Do NOT put real secrets here.
#   * Data roots default to /data/cryptorecorder/* (see docs/OPERATIONS.md).
#   * archive_days is a PLACEHOLDER. Syncthing archive generation is NOT
#     implemented; this path is reserved for future use. There is no feature
#     store, label store, or catalog-jobs root (issue #17 removed them).
#   * The deploy script copies this template to the env-file path only if one does
#     not already exist (it never overwrites an existing env file).

# ---------------------------------------------------------------------------
# Selection policy
# ---------------------------------------------------------------------------
CRYPTO_RECORDER_TOP_SYMBOLS=50

# ---------------------------------------------------------------------------
# Data roots (all under the dedicated data volume)
# ---------------------------------------------------------------------------
CRYPTO_RECORDER_DATA_ROOT=/data/cryptorecorder/data_raw
CRYPTO_RECORDER_STATE_ROOT=/data/cryptorecorder/state
CRYPTO_RECORDER_REPLAY_ROOT=/data/cryptorecorder/replay_store
CRYPTO_RECORDER_DAILY_REPORT_ROOT=/data/cryptorecorder/daily_build_reports
CRYPTO_RECORDER_NAUTILUS_CATALOG_ROOT=/data/cryptorecorder/catalog

# Placeholder only (no code reads/writes this yet):
CRYPTO_RECORDER_ARCHIVE_DAYS_ROOT=/data/cryptorecorder/archive_days

# ---------------------------------------------------------------------------
# Disk limits (optional)
# ---------------------------------------------------------------------------
# Raw-retention thresholds (GB). Apply to fresh `data_raw` disk usage only —
# never to filesystem capacity, and never to the cross-root observability
# total (data_raw + catalog + meta + state), which may span different
# filesystems and never drives cleanup decisions.
CRYPTO_RECORDER_DISK_SOFT_LIMIT_GB=750
CRYPTO_RECORDER_DISK_HARD_LIMIT_GB=850
CRYPTO_RECORDER_DISK_CLEANUP_TARGET_GB=700

# Recursive `du` scan timeout (seconds). Raised from the historical 30s
# hard-coded value because the raw tree can exceed that; a scan that still
# times out is reported as an explicit failure, never as a fake zero
# (see disk_monitor.py / issue #19).
CRYPTO_RECORDER_DISK_SCAN_TIMEOUT_SEC=60.0

# How long a last-known-good directory measurement may be reused as a
# "stale" fallback before disk_usage.json flags it with a staleness alert.
CRYPTO_RECORDER_DISK_MEASUREMENT_STALE_AFTER_SEC=1800.0

# Independent filesystem-capacity alert thresholds (GB free), separate from
# the raw-retention thresholds above.
CRYPTO_RECORDER_DISK_FS_FREE_WARN_GB=100.0
CRYPTO_RECORDER_DISK_FS_FREE_CRITICAL_GB=50.0

# Bounded growth-rate history (only successful, non-stale samples are ever
# recorded).
CRYPTO_RECORDER_DISK_HISTORY_MAX_SAMPLES=288
CRYPTO_RECORDER_DISK_HISTORY_MAX_AGE_SEC=172800.0

# ---------------------------------------------------------------------------
# Optional tuning (uncomment to override defaults)
# ---------------------------------------------------------------------------
# CRYPTO_RECORDER_TOP_SYMBOL_CANDIDATES=120
# CRYPTO_RECORDER_FUTURES_TOP_SYMBOL_CANDIDATES=200
# CRYPTO_RECORDER_EMIT_DERIVED_DEPTH_SNAPSHOTS=1
# CRYPTO_RECORDER_DERIVED_DEPTH_SNAPSHOT_INTERVAL_SEC=1.0
# CRYPTO_RECORDER_DEPTH_WS_MAX_SYMBOLS_PER_CONNECTION=10
# CRYPTO_RECORDER_TRADE_WS_MAX_SYMBOLS_PER_CONNECTION=10

# Writer backpressure tuning. Depth is protected first; trade queues may drop
# under sustained local writer pressure.
# CRYPTO_RECORDER_WRITER_QUEUE_MAX_SIZE=10000
# CRYPTO_RECORDER_DEPTH_WRITER_QUEUE_MAX_SIZE=20000
# CRYPTO_RECORDER_TRADE_WRITER_QUEUE_MAX_SIZE=5000
# CRYPTO_RECORDER_WRITER_BATCH_SIZE=1000
# CRYPTO_RECORDER_WRITER_FLUSH_INTERVAL_SEC=5.0
# CRYPTO_RECORDER_DEPTH_WRITER_ENQUEUE_TIMEOUT_SEC=0
# CRYPTO_RECORDER_TRADE_WRITER_ENQUEUE_TIMEOUT_SEC=1.0
# CRYPTO_RECORDER_DEPTH_BLOCK_WARN_INTERVAL_SEC=10.0
# CRYPTO_RECORDER_DEPTH_BLOCK_ALERT_SEC=30.0
# CRYPTO_RECORDER_WRITER_TELEMETRY_LOG_INTERVAL_SEC=60
# CRYPTO_RECORDER_WRITER_COMPRESSION_WORKERS=1
# CRYPTO_RECORDER_WRITER_COMPRESSION_SHUTDOWN_TIMEOUT_SEC=60.0
