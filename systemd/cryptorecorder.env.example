# Optional non-secret runtime tuning loaded by the systemd unit files.
# Copy selected lines into /etc/cryptorecorder/cryptorecorder.env as needed.

CRYPTO_RECORDER_TOP_SYMBOLS=50
CRYPTO_RECORDER_DATA_ROOT=/data/cryptorecorder/data_raw
CRYPTO_RECORDER_NAUTILUS_CATALOG_ROOT=/home/zsombor0918/sync/catalog
CRYPTO_RECORDER_DISK_SOFT_LIMIT_GB=750
CRYPTO_RECORDER_DISK_HARD_LIMIT_GB=850
CRYPTO_RECORDER_DISK_CLEANUP_TARGET_GB=700
# CRYPTO_RECORDER_TOP_SYMBOL_CANDIDATES=120
# CRYPTO_RECORDER_FUTURES_TOP_SYMBOL_CANDIDATES=200
# CRYPTO_RECORDER_STATE_ROOT=/home/zsom/services/CryptoRecorder/state
# CRYPTO_RECORDER_EMIT_DERIVED_DEPTH_SNAPSHOTS=1
# CRYPTO_RECORDER_DERIVED_DEPTH_SNAPSHOT_INTERVAL_SEC=1.0
# CRYPTO_RECORDER_DEPTH_WS_MAX_SYMBOLS_PER_CONNECTION=10
# CRYPTO_RECORDER_TRADE_WS_MAX_SYMBOLS_PER_CONNECTION=10

# Writer backpressure tuning. Depth is protected first; trade queues may drop
# under sustained local writer pressure.
# CRYPTO_RECORDER_WRITER_QUEUE_MAX_SIZE=10000
# CRYPTO_RECORDER_DEPTH_WRITER_QUEUE_MAX_SIZE=20000
# CRYPTO_RECORDER_TRADE_WRITER_QUEUE_MAX_SIZE=5000
# CRYPTO_RECORDER_WRITER_BATCH_SIZE=1000
# CRYPTO_RECORDER_WRITER_FLUSH_INTERVAL_SEC=5.0
# CRYPTO_RECORDER_DEPTH_WRITER_ENQUEUE_TIMEOUT_SEC=0
# CRYPTO_RECORDER_TRADE_WRITER_ENQUEUE_TIMEOUT_SEC=1.0
# CRYPTO_RECORDER_DEPTH_BLOCK_WARN_INTERVAL_SEC=10.0
# CRYPTO_RECORDER_DEPTH_BLOCK_ALERT_SEC=30.0
# CRYPTO_RECORDER_WRITER_TELEMETRY_LOG_INTERVAL_SEC=60
# CRYPTO_RECORDER_WRITER_COMPRESSION_WORKERS=1
